[ext_resource type="Resource" path="res://data/rooms/relic_reward_room.tres" id="11_relic"]

[sub_resource type="Resource" id="RoutePool_start"]
script = ExtResource("2_pool")
rooms = Array[ExtResource("3_start")]([ExtResource("3_start")])

[sub_resource type="Resource" id="RoutePool_tutorial_combat"]
script = ExtResource("2_pool")
rooms = Array[ExtResource("4_combat")]([ExtResource("4_combat")])

[sub_resource type="Resource" id="RoutePool_reward"]
script = ExtResource("2_pool")
rooms = Array[ExtResource("5_reward")]([ExtResource("5_reward")])

[sub_resource type="Resource" id="RoutePool_random_combat"]
script = ExtResource("2_pool")
rooms = Array[ExtResource("4_combat")]([ExtResource("4_combat"), ExtResource("6_swarm")])

[sub_resource type="Resource" id="RoutePool_elite"]
script = ExtResource("2_pool")
rooms = Array[ExtResource("7_elite")]([ExtResource("7_elite")])

[sub_resource type="Resource" id="RoutePool_event"]
