rooms = Array[ExtResource("11_relic")]([ExtResource("11_relic")])

[resource]
script = ExtResource("1_random")
room_pools = Array[ExtResource("2_pool")]([SubResource("RoutePool_start"), SubResource("RoutePool_tutorial_combat"), SubResource("RoutePool_reward"), SubResource("RoutePool_random_combat"), SubResource("RoutePool_event"), SubResource("RoutePool_elite"), SubResource("RoutePool_relic"), SubResource("RoutePool_boss")])
