[gd_resource type="Resource" script_class="EvolutionData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/evolutions/evolution_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_effect"]
[ext_resource type="PackedScene" path="res://scenes/player/forms/hive_mother_visual.tscn" id="3_visual"]
[ext_resource type="Resource" path="res://data/evolutions/effects/hive_mother_attack_effect.tres" id="4_stats"]
[ext_resource type="Resource" path="res://data/evolutions/effects/hive_mother_split_effect.tres" id="5_split"]

[resource]
script = ExtResource("1_data")
id = &"hive_mother"
display_name = "群巢母体"
description = "分裂与穿透基因共鸣，一次孕育六枚穿透弹体。"
priority = 20
required_gene_ids = Array[StringName]([&"split", &"piercing"])
visual_scene = ExtResource("3_visual")
effects = Array[ExtResource("2_effect")]([ExtResource("4_stats"), ExtResource("5_split")])
