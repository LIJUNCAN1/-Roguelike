[gd_resource type="Resource" script_class="EvolutionData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/evolutions/evolution_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_effect"]
[ext_resource type="PackedScene" path="res://scenes/player/forms/mitosis_life_visual.tscn" id="3_visual"]
[ext_resource type="Resource" path="res://data/evolutions/effects/mitosis_life_attack_effect.tres" id="4_attack"]
[ext_resource type="Resource" path="res://data/art/player_original_visual.tres" id="9_pixel"]

[resource]
script = ExtResource("1_data")
id = &"mitosis_life"
display_name = "裂殖生命"
description = "身体分裂为协同细胞，弹体更小、更快。"
priority = 10
required_gene_ids = Array[StringName]([&"split"])
visual_scene = ExtResource("3_visual")
pixel_visual_data = ExtResource("9_pixel")
effects = Array[ExtResource("2_effect")]([ExtResource("4_attack")])
