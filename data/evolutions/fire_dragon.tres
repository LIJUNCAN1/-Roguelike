[resource]
script = ExtResource("1_evolution_data")
id = &"fire_dragon"
display_name = "炎龙"
description = "炎爆流完成共鸣后形成的进化形态。"
priority = 20
required_fusion_ids = Array[StringName]([&"fire_burst"])
