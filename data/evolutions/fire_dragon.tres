[gd_resource type="Resource" script_class="EvolutionData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/evolutions/evolution_data.gd" id="1_evolution_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_gene_effect"]
[ext_resource type="PackedScene" path="res://scenes/player/forms/fire_dragon_visual.tscn" id="3_visual"]
[ext_resource type="Resource" path="res://data/evolutions/effects/fire_dragon_attack_effect.tres" id="4_effect"]
