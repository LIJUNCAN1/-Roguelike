[resource]
script = ExtResource("1_data")
id = &"abyss_devourer"
display_name = "深渊吞噬者"
description = "吸血与爆炸基因共鸣，吞噬范围扩大并强化续航。"
priority = 20
required_gene_ids = Array[StringName]([&"lifesteal", &"explosion"])
