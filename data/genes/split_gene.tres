[gd_resource type="Resource" script_class="GeneData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/genes/gene_data.gd" id="1_gene_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_gene_effect"]
[ext_resource type="Resource" path="res://data/genes/effects/split_projectile_effect.tres" id="3_split_effect"]

[resource]
script = ExtResource("1_gene_data")
id = &"split"
display_name = "分裂基因"
description = "每次攻击同时发射三枚带有夹角的子弹。"
series_id = &"propagation"
series_name = "增殖系列"
effects = Array[ExtResource("2_gene_effect")]([ExtResource("3_split_effect")])
