[gd_resource type="Resource" script_class="GeneData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/genes/gene_data.gd" id="1_gene_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_gene_effect"]
[ext_resource type="Resource" path="res://data/genes/effects/fire_projectile_effect.tres" id="3_fire_effect"]

[resource]
script = ExtResource("1_gene_data")
id = &"fire"
display_name = "火焰基因"
description = "普通攻击转化为更大、更慢、伤害更高的火焰弹。"
series_id = &"combustion"
series_name = "燃烧系列"
effects = Array[ExtResource("2_gene_effect")]([ExtResource("3_fire_effect")])
