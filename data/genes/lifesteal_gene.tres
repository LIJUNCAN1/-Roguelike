[gd_resource type="Resource" script_class="GeneData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/genes/gene_data.gd" id="1_gene_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_gene_effect"]
[ext_resource type="Resource" path="res://data/genes/effects/lifesteal_on_hit_effect.tres" id="3_lifesteal_effect"]

[resource]
script = ExtResource("1_gene_data")
id = &"lifesteal"
display_name = "吸血基因"
description = "攻击命中后回复实际伤害 50% 的生命。"
series_id = &"survival"
series_name = "生存系列"
effects = Array[ExtResource("2_gene_effect")]([ExtResource("3_lifesteal_effect")])
