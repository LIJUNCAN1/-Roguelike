[gd_resource type="Resource" script_class="GeneData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/genes/gene_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/genes/gene_effect.gd" id="2_effect"]
[ext_resource type="Resource" path="res://data/genes/effects/titan_projectile_effect.tres" id="3_gene_effect"]

[resource]
script = ExtResource("1_data")
id = &"titan"
display_name = "巨化基因"
description = "弹体巨大而沉重，造成更高伤害。"
rarity = 2
category = 3
tags = Array[StringName]([&"projectile", &"size", &"damage"])
series_id = &"adaptation"
series_name = "适应系列"
effects = Array[ExtResource("2_effect")]([ExtResource("3_gene_effect")])
